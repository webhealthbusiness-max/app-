PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
RATE_LIMIT_WINDOW_MS=60000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:4173
DATABASE_PATH=./data/grounded.db
APP_BASE_URL=http://localhost:3000
# Enable to exercise email verification in staging; production always requires it.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Configure either Gmail SMTP (use a Google App Password, never your account password)
# or another SMTP provider. Leave all four empty to disable email delivery locally.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Create a Google OAuth Web application client ID. Use the same client ID in both settings.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Plaid is disabled until all three values are configured.
# Sandbox is for test data only; use production only after Plaid approves the app.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate with: openssl rand -hex 32. Keep stable and private; losing it prevents token decryption.
BANK_TOKEN_ENCRYPTION_KEY=
# Optional OAuth redirect URL, registered in your Plaid dashboard.
PLAID_REDIRECT_URI=
# Create recurring Stripe Prices: USD 5.99/month and USD 59.99/year.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Set only when running behind a reverse proxy you control.
# TRUST_PROXY_HOPS=1

# Encrypted SQLite backups (server-side only; never use VITE_ prefixes).
# Generate a separate key with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=./backups
