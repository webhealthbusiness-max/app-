{
  "name": "grounded-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "test": "node --test",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "backup": "node scripts/backup-db.js",
    "restore": "node scripts/restore-db.js",
    "check:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.0",
    "plaid": "^48.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.7"
  }
}
